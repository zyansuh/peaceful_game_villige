# Database (required)
# Local SQLite — file created under app/backend/
DATABASE_URL=sqlite:///./gamema.db

# Production example (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/gamema

# Server
HOST=0.0.0.0
PORT=8000

# Auth / JWT (recommended for login features)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Admin bootstrap (optional — creates admin user on startup)
ADMIN_USER_ID=admin
ADMIN_USER_EMAIL=admin@example.com

# Local dev logging (INFO = quiet terminal, DEBUG = verbose SQL)
LOG_LEVEL=INFO

# OIDC (Atoms Cloud / production login)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid profile email

# Frontend URL (callbacks)
# FRONTEND_URL=http://localhost:3000
