# Database
DATABASE_URL=sqlite:///./gamema.db

# JWT (JWT_SECRET 또는 JWT_SECRET_KEY)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend
FRONTEND_URL=http://localhost:3000
# 운영 (Vercel): https://peaceful-game-villige.vercel.app

# Discord OAuth2 — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# 개발: http://localhost:3000/api/v1/auth/discord/callback
# 운영: https://peaceful-game-villige.vercel.app/api/v1/auth/discord/callback
DISCORD_REDIRECT_URI=
DISCORD_GUILD_CHECK=true
DISCORD_ADMIN_IDS=
DISCORD_TEACHER_IDS=

# HttpOnly cookie (운영 https 시 true)
COOKIE_SECURE=false

LOG_LEVEL=INFO

# Vercel 프록시 (프론트 배포 시 Vercel Variables에 설정)
# RAILWAY_BACKEND_URL=https://YOUR-SERVICE.up.railway.app
