# Database (required)
# Local SQLite — file created under app/backend/
DATABASE_URL=sqlite:///./gamema.db

# Production example (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/gamema

# Server
HOST=0.0.0.0
PORT=8000

# Auth / JWT (required)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend (Discord OAuth redirect after login)
FRONTEND_URL=http://localhost:3000

# Discord OAuth2 — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 평화로운게임마을 Discord 서버(길드) ID — 이 서버 멤버만 로그인 허용
DISCORD_GUILD_ID=
# Redirect URI (Discord Developer Portal에 동일하게 등록)
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/discord/callback
# 로컬 테스트 시 서버 가입 검사 끄기: DISCORD_GUILD_CHECK=false

# Staff 권한 (Discord User ID, 쉼표 구분)
# DISCORD_ADMIN_IDS=123456789012345678
# DISCORD_TEACHER_IDS=987654321098765432

# Admin bootstrap (legacy OIDC — optional)
ADMIN_USER_ID=admin
ADMIN_USER_EMAIL=admin@example.com

# Local dev logging (INFO = quiet terminal, DEBUG = verbose SQL)
LOG_LEVEL=INFO

# OIDC (Atoms Cloud — optional)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid profile email
