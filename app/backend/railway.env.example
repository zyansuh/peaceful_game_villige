# Railway (백엔드) — Variables 탭에 설정
# PostgreSQL 추가 후 DATABASE_URL Reference 연결

DATABASE_URL=postgresql://user:pass@host:5432/railway

FRONTEND_URL=https://peaceful-game-villige.vercel.app
DISCORD_REDIRECT_URI=https://peaceful-game-villige.vercel.app/api/v1/auth/discord/callback
COOKIE_SECURE=true

JWT_SECRET_KEY=change-me-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_GUILD_CHECK=true
DISCORD_ADMIN_IDS=
DISCORD_TEACHER_IDS=

LOG_LEVEL=INFO

# Railway Settings:
#   Root Directory = app/backend
#   (startCommand는 railway.toml / Procfile 참고)
#   Networking → Generate Domain → /docs 확인

# Vercel (프론트) — Environment Variables
# RAILWAY_BACKEND_URL=https://YOUR-SERVICE.up.railway.app
