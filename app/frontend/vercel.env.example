# Vercel Environment Variables (Project Settings → Environment Variables)
# 프론트 + 백엔드(API) 모두 Vercel에서 실행됩니다. Railway 불필요.

# ── 필수: DB (Neon 무료 Postgres 권장) ──
# https://neon.tech → 프로젝트 생성 → Connection string 복사
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── 프론트 URL (Discord redirect·쿠키용) ──
FRONTEND_URL=https://peaceful-game-villige.vercel.app
# 미설정 시 VERCEL_URL 자동 사용 (프리뷰 배포 시 해당 URL로 동작)

# ── Discord OAuth ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=https://peaceful-game-villige.vercel.app/api/v1/auth/discord/callback
DISCORD_GUILD_CHECK=true
DISCORD_ADMIN_IDS=
DISCORD_TEACHER_IDS=

# ── JWT ──
JWT_SECRET_KEY=32자이상_랜덤_문자열
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── 쿠키 (Vercel HTTPS) ──
COOKIE_SECURE=true

LOG_LEVEL=INFO

# Discord Developer Portal Redirect URI:
#   https://peaceful-game-villige.vercel.app/api/v1/auth/discord/callback
#
# Vercel 프로젝트 설정:
#   Root Directory = app/frontend
#   Framework = Vite
#
# Neon DB는 SQLite 대신 필수 (서버리스는 파일 DB 불가)
